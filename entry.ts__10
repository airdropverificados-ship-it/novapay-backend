const db = globalThis.__B44_DB__ || { auth:{ isAuthenticated: async()=>false, me: async()=>null }, entities:new Proxy({}, { get:()=>({ filter:async()=>[], get:async()=>null, create:async()=>({}), update:async()=>({}), delete:async()=>({}) }) }), integrations:{ Core:{ UploadFile:async()=>({ file_url:'' }) } } };

import { createClientFromRequest } from 'npm:@base44/sdk@0.8.40';
import { isSuperAdmin } from "../../shared/admin.ts";

export default async function(req) {
  try {
    const base44 = createClientFromRequest(req);
    const user = await db.auth.me();
    if (!user) return Response.json({ error: 'Unauthorized' }, { status: 401 });

    const members = await db.asServiceRole.entities.Member.filter({ created_by_id: user.id });
    const member = members && members[0];
    if (!isSuperAdmin(member) && user.role !== 'admin') {
      return Response.json({ error: 'Forbidden' }, { status: 403 });
    }

    const body = await req.json().catch(() => ({}));
    const patch = {};
    if (body.active_theme) patch.active_theme = String(body.active_theme);
    if (typeof body.roulette_enabled === 'boolean') patch.roulette_enabled = body.roulette_enabled;
    if (typeof body.chests_enabled === 'boolean') patch.chests_enabled = body.chests_enabled;
    if (body.airdrop_cap_nvt != null) patch.airdrop_cap_nvt = Number(body.airdrop_cap_nvt);
    if (!Object.keys(patch).length) return Response.json({ error: 'Nada que actualizar' }, { status: 400 });

    const list = await db.asServiceRole.entities.AppConfig.list();
    let cfg = list && list[0];
    if (!cfg) {
      cfg = await db.asServiceRole.entities.AppConfig.create({
        active_theme: 'normal', roulette_enabled: true, chests_enabled: true, airdrop_cap_nvt: 15000,
      });
    }
    await db.asServiceRole.entities.AppConfig.update(cfg.id, patch);
    return Response.json({ ok: true, config: { ...cfg, ...patch } });
  } catch (error) {
    return Response.json({ error: error.message }, { status: 500 });
  }
}